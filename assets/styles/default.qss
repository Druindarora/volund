/* === Vølund Dark Theme (global) === */

/* Fond & texte par défaut */
QWidget {
  background: #333333;
  color: #E0E0E0;
  selection-background-color: #2F6FEB; /* bleu sélection */
  selection-color: #FFFFFF;
}

QMainWindow, QDialog, QStackedWidget, QScrollArea, QScrollArea QWidget {
  background: #333333;
  color: #E0E0E0;
}

/* Liens / labels accentués */
QLabel[role="muted"="true"] { color: #A0A0A0; }
QLabel[role="accent"="true"] { color: #7AA2F7; }

/* Group boxes / cards */
QGroupBox {
  border: 1px solid #2A2A2A;
  border-radius: 8px;
  margin-top: 10px;
  padding: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #CFCFCF; }

/* Champs texte */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
  background: #1C1C1C;
  color: #E0E0E0;
  border: 1px solid #333;
  border-radius: 6px;
  padding: 4px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
  border-color: #2F6FEB;
}

/* Combos */
QComboBox {
  background: #1C1C1C; border: 1px solid #333; border-radius: 6px; padding: 4px 28px 4px 8px; color: #E0E0E0;
}
QComboBox QAbstractItemView {
  background: #1C1C1C; color: #E0E0E0; selection-background-color: #2F6FEB; selection-color: #FFF; border: 1px solid #333;
}

/* Listes / arbres / tables */
QListView, QTreeView, QTableView { background: #1A1A1A; border: 1px solid #2A2A2A; }
QHeaderView::section { background: #1F1F1F; color: #CFCFCF; border: 1px solid #2A2A2A; padding: 4px; }
QTreeView::item:selected, QListView::item:selected { background: #2F6FEB; color: #FFF; }
QTreeView::item:hover, QListView::item:hover { background: #232323; }

/* Boutons */
QPushButton {
  background: #1E1E1E;
  color: #E0E0E0;
  border: 1px solid #333;
  border-radius: 8px;
  padding: 6px 10px;
}
QPushButton:hover { background: #2A2A2A; }
QPushButton:pressed { background: #252525; }
QPushButton:disabled { background: #1A1A1A; color: #777; border-color: #2A2A2A; }

/* Bouton primaire (via objectName="primaryButton") */
QPushButton#primaryButton { background: #2F6FEB; border-color: #275BD1; color: #FFF; }
QPushButton#primaryButton:hover { background: #3B79FF; }
QPushButton#primaryButton:pressed { background: #2A67E6; }

/* Tabs */
QTabWidget::pane { border: 1px solid #2A2A2A; }
QTabBar::tab { background: #1C1C1C; color: #CFCFCF; padding: 6px 10px; border: 1px solid #2A2A2A; border-bottom: none; }
QTabBar::tab:selected { background: #232323; color: #FFF; }
QTabBar::tab:hover { background: #252525; }

/* Scrollbars */
QScrollBar:vertical { background: #151515; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #2B2B2B; min-height: 24px; border-radius: 6px; }
QScrollBar::handle:vertical:hover { background: #363636; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #151515; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: #2B2B2B; min-width: 24px; border-radius: 6px; }
QScrollBar::handle:horizontal:hover { background: #363636; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* Barre d'état / tooltips */
QStatusBar { background: #151515; color: #CFCFCF; }
QToolTip { background: #2A2A2A; color: #E0E0E0; border: 1px solid #3A3A3A; }

/* Cards génériques */
#cardStyle {
  border: 1px solid #2A2A2A;
  border-radius: 8px;
  padding: 8px;
  color: #E0E0E0;
  background: #1C1C1C;
}

/* === Sidebar existante (conservée) === */
#Sidebar { background-color: #1A1A1A; border-right: 1px solid #333; }
#Sidebar QPushButton { border: none; color: white; padding-left: 6px; padding-right: 6px; }
#Sidebar QPushButton:hover { background-color: #2A2A2A; }
