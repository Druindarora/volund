# templates/logger_template.py.j2

import logging
from pathlib import Path


def get_logger(module_name: str) -> logging.Logger:
    """
    Retourne un logger configuré pour un module spécifique.
    Les logs vont à la fois dans la console et dans un fichier dédié.
    """
    logs_dir = Path("logs")
    logs_dir.mkdir(exist_ok=True)

    logger = logging.getLogger(module_name)
    if logger.handlers:  # éviter de doubler les handlers
        return logger

    logger.setLevel(logging.DEBUG)

    # Handler console
    console_handler = logging.StreamHandler()
    console_handler.setLevel(logging.INFO)
    console_formatter = logging.Formatter("[%(levelname)s] %(message)s")
    console_handler.setFormatter(console_formatter)

    # Handler fichier
    file_handler = logging.FileHandler(
        logs_dir / f"{{ '{{ module_name }}' }}.log", encoding="utf-8"
    )
    file_handler.setLevel(logging.DEBUG)
    file_formatter = logging.Formatter(
        "%(asctime)s - %(levelname)s - %(name)s - %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    file_handler.setFormatter(file_formatter)

    logger.addHandler(console_handler)
    logger.addHandler(file_handler)

    return logger
